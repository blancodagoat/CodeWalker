<Window x:Class="CodeWalker.ParticleEditorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:vm="clr-namespace:CodeWalker.ParticleEditorWpf.ViewModels"
        xmlns:ctl="clr-namespace:CodeWalker.ParticleEditorWpf.Controls"
        Title="Particle Editor - CodeWalker by dexyfex"
        Height="760" Width="1200"
        Background="#FF2D2D30" Foreground="#FFE0E0E0"
        UseLayoutRounding="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
        </Style>
        <!-- modern flat dark transport button -->
        <Style TargetType="Button" x:Key="TransportButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#FF34343A" BorderBrush="#FF45454E" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF40404A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF5A5A66"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF007ACC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF1C97EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- play/pause = the primary action, given an accent fill -->
        <Style TargetType="Button" x:Key="TransportPlayButton" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="#FF2C7D46" BorderBrush="#FF3FA15E" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF359352"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4FB870"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF26703D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- modern dark slider with an accent-filled track + round thumb -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#FF34343A" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#FF1C97EA" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="th" Fill="#FFF0F0F0" Stroke="#FF1C97EA" StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="th" Property="Fill" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeVM}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- colour-coded type badge -->
                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center"
                        Margin="0,0,8,0" Background="{Binding AccentColor}"/>
                <!-- name (effect rows are brighter + semibold so top-level entries stand out) -->
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"
                           Foreground="{Binding NameColor}" FontWeight="{Binding NameWeight}"/>
                <!-- emitter visibility toggle (only on emitter rows) -->
                <CheckBox Grid.Column="2" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                          Visibility="{Binding IsEmitter, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Show/hide this emitter in the preview"/>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- readable, roomier tree rows with full-width selection -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="Padding" Value="2,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="#FF3F3F46" Foreground="#FFE0E0E0">
            <MenuItem Header="_File" Foreground="Black">
                <MenuItem Header="New" Command="{Binding NewFileCommand}"/>
                <MenuItem Header="Open..." Command="{Binding OpenCommand}"/>
                <MenuItem Header="Save" Command="{Binding SaveCommand}"/>
                <MenuItem Header="Save As..." Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="Import XML..." Command="{Binding ImportXmlCommand}"/>
                <MenuItem Header="Export XML..." Command="{Binding ExportXmlCommand}"/>
                <Separator/>
                <MenuItem Header="Exit" Click="ExitMenu_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="Black">
                <MenuItem Header="New Effect" Command="{Binding NewEffectCommand}"/>
                <MenuItem Header="Duplicate Effect" Command="{Binding DuplicateCommand}"/>
                <MenuItem Header="Delete Selected" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="Add Emitter" Command="{Binding AddEmitterCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Transport bar -->
        <Border DockPanel.Dock="Top" Background="#FF2A2A2E" Padding="10,7" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource TransportButton}" Content="◼" Command="{Binding StopCommand}" ToolTip="Stop"/>
                <Button Style="{StaticResource TransportPlayButton}" Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="Play / Pause (Space)"/>
                <Button Style="{StaticResource TransportButton}" Content="↻" Command="{Binding RestartCommand}" ToolTip="Restart"/>

                <!-- separator -->
                <Border Width="1" Height="22" Background="#FF3F3F46" Margin="10,0"/>

                <!-- time readout -->
                <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" Foreground="#FFEDEDED"
                           FontFamily="Consolas, Cascadia Mono, Lucida Console" FontSize="13" MinWidth="160"/>

                <!-- separator -->
                <Border Width="1" Height="22" Background="#FF3F3F46" Margin="12,0"/>

                <!-- rate -->
                <TextBlock Text="Speed" VerticalAlignment="Center" Foreground="#FFB0B0B0" Margin="0,0,8,0"/>
                <Slider Style="{StaticResource ModernSlider}" Width="150" Minimum="0.05" Maximum="4"
                        Value="{Binding Rate}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Rate, StringFormat={}{0:0.00}×}" VerticalAlignment="Center"
                           Foreground="#FFEDEDED" FontFamily="Consolas, Cascadia Mono, Lucida Console"
                           Width="46" TextAlignment="Right" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF007ACC" Padding="6,2">
            <TextBlock Text="{Binding StatusText}" Foreground="White"/>
        </Border>

        <!-- Main content (top) + drag-resizable keyframe editor (bottom) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- Main content: left browser | viewport | properties -->
            <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="330" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <!-- Left: effects browser + behaviour grid -->
            <Grid Grid.Column="0" Background="#FF252526">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="  Effects" Background="#FF333337" Padding="2" FontWeight="Bold"/>
                <Border Grid.Row="1" Background="#FF2D2D30" Padding="4" BorderBrush="#FF3F3F46" BorderThickness="0,0,0,1">
                    <TextBox x:Name="EffectsSearch" Background="#FF1E1E1E" Foreground="#FFE0E0E0" ToolTip="search effects by name"
                             BorderBrush="#FF3F3F46" Padding="3,2" CaretBrush="#FFE0E0E0"
                             Text="{Binding EffectsFilter, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
                <TreeView x:Name="EffectsTree" Grid.Row="2" ItemsSource="{Binding Effects}"
                          Background="#FF1E1E1E" Foreground="#FFE0E0E0" BorderThickness="0"
                          SelectedItemChanged="EffectsTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <!-- dark-theme selection highlight so selected text stays readable -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF094771"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3F3F46"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                    </TreeView.Resources>
                </TreeView>
                <TextBlock Grid.Row="3" Text="  Behaviours (selected particle rule)" Background="#FF333337" Padding="2" FontWeight="Bold"/>
                <ItemsControl Grid.Row="4" ItemsSource="{Binding BehaviourToggles}" Margin="4" MinHeight="40">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Present}" Width="120" Margin="2" Foreground="#FFE0E0E0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="#FF3F3F46"/>

            <!-- Center: DirectX viewport -->
            <Border Grid.Column="2" Background="Black">
                <wf:WindowsFormsHost x:Name="ViewportHost"/>
            </Border>

            <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Stretch" Background="#FF3F3F46"/>

            <!-- Right: property panel -->
            <ctl:PropertyPanelControl x:Name="PropertyPanel" Grid.Column="4"/>
            </Grid>

            <!-- drag this to make the keyframe editor taller / shorter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Background="#FF3F3F46" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"
                          Cursor="SizeNS"/>

            <!-- Keyframe timeline / graph editor -->
            <Border Grid.Row="2" BorderBrush="#FF3F3F46" BorderThickness="0,1,0,0">
                <ctl:KeyframeEditorControl x:Name="KeyframeEditor"/>
            </Border>
        </Grid>

    </DockPanel>
</Window>
